# Provider key used by the two default OpenAI-backed variants.
OPENAI_API_KEY=

# Keep AgentLab account/run bookkeeping for this experiment under the project.
# This path must be absolute if set.
AGENTLAB_HOME=/Users/jevinnishioka/Desktop/rex-modal-8-worker-experiment/.agentlab

# Modal launcher settings read by AgentLab's --executor modal path.
AGENTLAB_MODAL_APP_NAME=agentlab-rex-modal
AGENTLAB_MODAL_ENVIRONMENT=
AGENTLAB_MODAL_PYTHON=/Users/jevinnishioka/Desktop/rex-modal-8-worker-experiment/.venv-modal/bin/python

# Cloudflare R2 S3-compatible sync used by Modal sandboxes.
AGENTLAB_MODAL_S3_BUCKET=agentlab-rex-modal-20260521
AGENTLAB_MODAL_S3_PREFIX=agentlab-runs/rex-modal-8-worker-smoke
AGENTLAB_MODAL_S3_REGION=auto
AGENTLAB_MODAL_S3_ENDPOINT_URL=https://2c5c6d868af60c47fe133c773dbb00ee.r2.cloudflarestorage.com
AGENTLAB_MODAL_S3_SECRET=
AGENTLAB_MODAL_S3_FORCE_PATH_STYLE=true

# Fill these from a Cloudflare R2 S3 API token with Object Read & Write access.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=auto

# Keep the requested worker fanout explicit at both scheduling and runner-cap layers.
AGENTLAB_LOCAL_WORKER_MAX_IN_FLIGHT=8
AGENTLAB_MODAL_MAX_ACTIVE_SANDBOXES=8
