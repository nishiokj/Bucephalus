BUCEPHALUS_GCP_PROJECT=gen-lang-client-0255842044
BUCEPHALUS_GCP_ZONE=us-central1-a
BUCEPHALUS_GCP_REGION=us-central1

# Leave unset to choose from run requirements:
# - e2-medium for <= 2 vCPU and <= 4096 MB
# - e2-standard-N otherwise
# BUCEPHALUS_GCP_MACHINE_TYPE=e2-standard-4

# Leave unset to allocate at least 64 GB, or run disk requirement + 16 GB.
# The console sample's 10 GB disk is too small for the runner cleanup contract.
# BUCEPHALUS_GCP_BOOT_DISK_GB=64

BUCEPHALUS_GCP_IMAGE=projects/debian-cloud/global/images/family/debian-12
BUCEPHALUS_GCP_SUBNET=default
BUCEPHALUS_GCP_NETWORK_TIER=PREMIUM
BUCEPHALUS_GCP_DISK_TYPE=pd-balanced
BUCEPHALUS_GCP_SERVICE_ACCOUNT=380690977483-compute@developer.gserviceaccount.com
BUCEPHALUS_GCP_SCOPES=https://www.googleapis.com/auth/devstorage.read_only,https://www.googleapis.com/auth/logging.write,https://www.googleapis.com/auth/monitoring.write,https://www.googleapis.com/auth/service.management.readonly,https://www.googleapis.com/auth/servicecontrol,https://www.googleapis.com/auth/trace.append

# Optional split for local control planes. The pool controller can use
# DATABASE_URL=postgres://...@127.0.0.1:55432/... while runner VMs receive this
# Tailscale-reachable URL.
# BUCEPHALUS_WORKER_DATABASE_URL=postgres://bucephalus:bucephalus_dev@100.x.y.z:55433/bucephalus_cloud

# Optional release install. If omitted, the image must already contain:
# /usr/local/bin/bucephalus, /opt/bucephalus-cloud, Bun, and Docker when
# advertising docker_daemon.
# BUCEPHALUS_RELEASE_URL=https://storage.googleapis.com/example/bucephalus-0.1.0-x86_64-linux.tar.gz
# BUCEPHALUS_RELEASE_URL=gs://example-bucket/releases/bucephalus-0.1.0-x86_64-linux.tar.gz
# BUCEPHALUS_RELEASE_SHA256=

# Optional private-network bootstrap. Use an ephemeral, pre-approved, tagged
# auth key for runner VMs that must reach a Mac Studio or private control plane.
# BUCEPHALUS_TAILSCALE_AUTHKEY=tskey-auth-...
# BUCEPHALUS_TAILSCALE_EXTRA_ARGS=--accept-routes

# The GCP startup script can install docker.io on Debian for smoke tests.
# Production images should normally bake this dependency instead.
BUCEPHALUS_GCP_INSTALL_DOCKER=true
BUCEPHALUS_GCP_INSTALL_BUN=true

# Local provider smoke only. This prints the gcloud command without creating VM.
BUCEPHALUS_GCP_DRY_RUN=false
