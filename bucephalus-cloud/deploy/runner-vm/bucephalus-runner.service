[Unit]
Description=Bucephalus Cloud Runner VM daemon
Documentation=file:/opt/bucephalus-cloud/deploy/runner-vm/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=bucephalus-runner
Group=bucephalus-runner
EnvironmentFile=/etc/bucephalus-runner/runner.env
WorkingDirectory=/opt/bucephalus-cloud
ExecStart=/usr/bin/env bun run src/worker.ts
Restart=always
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/bucephalus-runner /etc/bucephalus-runner

[Install]
WantedBy=multi-user.target
