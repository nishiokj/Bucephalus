# Required: Cloud API endpoint used for package download, runner registration,
# run claiming, heartbeats, and events.
BUCEPHALUS_CLOUD_API_URL=https://api.bucephalus.example

# Required while the worker uses Postgres LISTEN for event-driven wakeups.
# This should be scoped for runner queue notifications, not broad admin access.
DATABASE_URL=postgres://bucephalus_runner:change-me@postgres.example:5432/bucephalus_cloud

# Optional: Postgres URL passed to Core for durable runtime persistence.
# Defaults to DATABASE_URL when omitted. Use this when runner VMs reach Postgres
# through a different private address than the Cloud API process.
# Must be a least-privilege runtime role for an already-migrated schema; runner
# VMs must not have CREATE/ALTER/DROP privileges.
BUCEPHALUS_WORKER_DATABASE_URL=
BUCEPHALUS_RUN_STORE_SCHEMA=bucephalus_runtime

# Required: bearer token for runner pool, runner instance, package download,
# and run attempt management endpoints.
BUCEPHALUS_CLOUD_WORKER_TOKEN=change-me

# Required: pool created by POST /v1/runner-pools.
BUCEPHALUS_RUNNER_POOL_ID=00000000-0000-0000-0000-000000000000

# Optional but required for pool-controller-managed VMs. These connect the VM
# registration back to the durable provision request that created it.
BUCEPHALUS_RUNNER_PROVISION_REQUEST_ID=
BUCEPHALUS_RUNNER_PROVIDER_INSTANCE_ID=

# Stable VM/daemon label. Defaults to hostname if omitted by the bootstrap script.
BUCEPHALUS_WORKER_ID=runner-vm-001

# Runner capabilities advertised by this VM.
BUCEPHALUS_WORKER_EXECUTORS=runner-docker
BUCEPHALUS_WORKER_RESOURCES=core_runner,docker_daemon,registry_pull
BUCEPHALUS_WORKER_ARCH=x86_64
BUCEPHALUS_WORKER_CPU_COUNT=4
BUCEPHALUS_WORKER_MEMORY_MB=8192
BUCEPHALUS_WORKER_DISK_MB=65536
BUCEPHALUS_WORKER_ISOLATION=reusable_vm

# Core and worker runtime.
BUCEPHALUS_CORE_RUNNER_CMD=/usr/local/bin/bucephalus
BUCEPHALUS_CLOUD_WORKER_DIR=/opt/bucephalus-cloud
BUCEPHALUS_CLOUD_DATA_DIR=/var/lib/bucephalus-runner
BUCEPHALUS_WORKER_SECRET_DIR=/etc/bucephalus-runner/secrets

# Queue lease and polling knobs.
BUCEPHALUS_WORKER_LEASE_SECONDS=30
BUCEPHALUS_WORKER_POLL_MS=2000
BUCEPHALUS_WORKER_SWEEPER_MS=5000

# VM resource and cleanup policy. The daemon validates this before claiming and
# poisons the runner instance if mandatory cleanup fails.
BUCEPHALUS_WORKER_MIN_FREE_BYTES=21474836480
BUCEPHALUS_WORKER_RETAIN_ATTEMPT_WORKSPACES=false
