[Unit]
Description=Bucephalus Cloud API
Documentation=file:/opt/bucephalus/current/bucephalus-cloud/deploy/control-plane/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bucephalus-cloud
Group=bucephalus-cloud
EnvironmentFile=/etc/bucephalus-cloud/control-plane.env
WorkingDirectory=/opt/bucephalus/current/bucephalus-cloud
ExecStart=/usr/bin/env bun run start
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/bucephalus-cloud /etc/bucephalus-cloud

[Install]
WantedBy=multi-user.target
