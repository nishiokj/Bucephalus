#
# Bucephalus Cloud control-plane VM environment.
#
# This file is for the Linux VM that owns Postgres, the Cloud API, and the
# pool-controller. The VM can be hosted by OrbStack, a Mac Studio Linux VM,
# GCP, AWS, Hetzner, or any future substrate. GCP runner VMs are separate
# ephemeral compute capacity provisioned by the pool-controller.
#

# API and local durable state.
BUCEPHALUS_CLOUD_HOST=0.0.0.0
PORT=8099
BUCEPHALUS_CLOUD_DATA_DIR=/var/lib/bucephalus-cloud

# Admin migrations should be run before starting services. Runtime processes
# should use non-DDL credentials once roles are split.
DATABASE_URL=postgres://bucephalus:change-me@127.0.0.1:5432/bucephalus_cloud

# URL that runner VMs and operator clients use to reach the API. Replace this
# example address with the control-plane VM's private/Tailscale/VPC address, not
# 127.0.0.1.
BUCEPHALUS_CLOUD_API_URL=http://192.0.2.10:8099

# Worker bearer token for runner management, package download, attempts, events,
# and pool-controller provider calls.
BUCEPHALUS_CLOUD_WORKER_TOKEN=change-me-worker-token

# User auth. For local smoke tests a dev token is acceptable. For production
# replace this with OAuth issuer/audience/JWKS config and remove the dev token.
BUCEPHALUS_CLOUD_AUTH_REQUIRED=true
BUCEPHALUS_CLOUD_OAUTH_DEV_TOKEN=change-me-local-user-token
BUCEPHALUS_CLOUD_USER_TOKEN=change-me-local-user-token
# BUCEPHALUS_CLOUD_OAUTH_ISSUER=https://issuer.example
# BUCEPHALUS_CLOUD_OAUTH_AUDIENCE=bucephalus-cloud
# BUCEPHALUS_CLOUD_OAUTH_JWKS_URL=https://issuer.example/.well-known/jwks.json

# Managed runner service. Create this pool once through the Cloud API/CLI and
# keep the id stable; it is internal capacity state, not a user-facing backend.
BUCEPHALUS_POOL_CONTROLLER_POOL_ID=00000000-0000-0000-0000-000000000000
BUCEPHALUS_POOL_CONTROLLER_PROVIDER=exec
BUCEPHALUS_POOL_CONTROLLER_PROVISION_CMD_JSON='["bun","run","deploy/provider/gcp/provision-runner-vm.js"]'
BUCEPHALUS_POOL_CONTROLLER_REAP_CMD_JSON='["bun","run","deploy/provider/gcp/reap-runner-vm.js"]'
BUCEPHALUS_POOL_CONTROLLER_POLL_MS=2000
BUCEPHALUS_POOL_CONTROLLER_STALE_INSTANCE_SECONDS=90
BUCEPHALUS_POOL_CONTROLLER_PROVISIONING_TIMEOUT_SECONDS=600
BUCEPHALUS_POOL_CONTROLLER_PROVIDER_CMD_TIMEOUT_MS=600000
BUCEPHALUS_POOL_CONTROLLER_DEMAND_LIMIT=50
BUCEPHALUS_POOL_CONTROLLER_REAP_IDLE_COMPLETED_RUNNERS=true
BUCEPHALUS_POOL_CONTROLLER_IDLE_REAP_DELAY_SECONDS=0

# Database URL injected into provisioned runner VMs. This should be reachable
# from the VM over private networking/Tailscale and should use least-privilege
# runtime credentials after migrations have been applied by an admin role.
BUCEPHALUS_WORKER_DATABASE_URL=postgres://bucephalus_runner:change-me@192.0.2.10:5432/bucephalus_cloud
BUCEPHALUS_RUN_STORE_SCHEMA=bucephalus_runtime

# GCP provider configuration for ephemeral runner VMs.
BUCEPHALUS_GCP_PROJECT=example-project
BUCEPHALUS_GCP_ZONE=us-central1-a
BUCEPHALUS_GCP_REGION=us-central1
BUCEPHALUS_GCP_IMAGE=projects/debian-cloud/global/images/family/debian-12
BUCEPHALUS_GCP_SUBNET=default
BUCEPHALUS_GCP_NETWORK_TIER=PREMIUM
BUCEPHALUS_GCP_DISK_TYPE=pd-balanced
# BUCEPHALUS_GCP_SERVICE_ACCOUNT=runner-provisioner@example.iam.gserviceaccount.com

# Runner release bootstrap. If omitted, the GCP image must already contain
# /usr/local/bin/bucephalus, /opt/bucephalus-cloud, Bun, and Docker.
# BUCEPHALUS_RELEASE_URL=gs://example-bucket/releases/bucephalus-0.3.1-x86_64-unknown-linux-gnu.tar.gz
# BUCEPHALUS_RELEASE_SHA256=

# Private-network bootstrap for GCP runner VMs. Use an ephemeral, tagged,
# pre-approved auth key for smoke paths. Move to provider secret retrieval before
# production.
# BUCEPHALUS_TAILSCALE_AUTHKEY=tskey-auth-...
BUCEPHALUS_TAILSCALE_EXTRA_ARGS=--accept-routes

# GCP startup script smoke defaults. Production runner images should normally
# bake these dependencies instead.
BUCEPHALUS_GCP_INSTALL_DOCKER=true
BUCEPHALUS_GCP_INSTALL_BUN=true
BUCEPHALUS_GCP_DRY_RUN=false
