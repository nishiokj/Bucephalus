project_id  = "my-gcp-project"
region      = "us-central1"
environment = "bucephalus"

deploy_control_plane_services = false
deploy_api_services           = false
deploy_pool_controller        = false

# Bucephalus starts with a cost-conscious managed Postgres profile. Scale these
# up deliberately when the environment needs production-like database capacity.
cloud_sql_tier                           = "db-g1-small"
cloud_sql_disk_size_gb                   = 10
cloud_sql_availability_type              = "ZONAL"
cloud_sql_point_in_time_recovery_enabled = false

# Image variables are supplied separately by the generated
# gcp-image-digests.tfvars handoff after pushed image promotion evidence is
# verified. They are required only when deploy_control_plane_services=true:
#
#   terraform plan -var-file=environments/dev.tfvars -var-file=/path/to/gcp-image-digests.tfvars
#
# The handoff includes api_image_digest, pool_controller_image_digest,
# migration_image_digest, and worker_image_digest.

oauth_issuer         = "https://accounts.google.com"
oauth_user_client_id = "<google-oauth-client-id>.apps.googleusercontent.com"
oauth_jwks_url       = "https://www.googleapis.com/oauth2/v3/certs"

# The values below are required only when deploy_api_services=true or
# deploy_pool_controller=true.
# Secret Manager "versions" are the integer revisions created when a value is
# added to an existing secret name.
#
# api_database_url_secret_version = "1"
# migrator_database_url_secret_version = "1"
# worker_token_secret_version = "1"
# runner_admin_token_secret_version = "1"
#
# The values below are required only when deploy_pool_controller=true.
#
# pool_controller_runner_pool_id = "00000000-0000-0000-0000-000000000000"
# pool_controller_provision_cmd_json_secret_version = "1"
# pool_controller_reap_cmd_json_secret_version = "1"

# Optional: enable Modal-backed Cloud runs on the same per-run GCE worker VMs.
# Terraform stores only Secret Manager version numbers and non-secret routing
# values. The actual Modal token and S3/R2 sync credentials must be added to the
# secret names emitted by the substrate output `secret_names`.
#
# modal_backend_enabled              = true
# modal_app_name                     = "bucephalus-prod"
# modal_environment                  = "main"
# modal_token_id_secret_version      = "1"
# modal_token_secret_secret_version  = "1"
# modal_s3_bucket                    = "bucephalus-runtime"
# modal_s3_prefix                    = "modal/runtime"
# modal_s3_endpoint_url              = "https://<account-id>.r2.cloudflarestorage.com"
# modal_s3_region                    = "auto"
# modal_s3_access_key_id_secret_version     = "1"
# modal_s3_secret_access_key_secret_version = "1"
# modal_gcp_artifact_registry_service_account_json_secret_version = "1"
#
# If credentials already live in a Modal Secret with AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY, set modal_s3_secret_name instead of the two S3 key
# Secret Manager version inputs above. Keep modal_s3_force_path_style=false:
# Modal CloudBucketMount does not expose path-style S3 mounting.
#
# If Modal task images are private GCP Artifact Registry refs, either set
# modal_gcp_artifact_registry_service_account_json_secret_version to a Secret
# Manager version containing a service-account JSON blob, or set
# modal_gcp_artifact_registry_secret_name to an existing Modal Secret containing
# SERVICE_ACCOUNT_JSON.
