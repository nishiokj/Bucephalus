ARG BUCEPHALUS_BUN_BASE_IMAGE
FROM ${BUCEPHALUS_BUN_BASE_IMAGE}

ARG BUCEPHALUS_RELEASE_VERSION
ARG BUCEPHALUS_RELEASE_GIT_SHA
ARG BUCEPHALUS_RELEASE_MANIFEST_SHA256
ARG BUCEPHALUS_IMAGE_COMPONENT=pool-controller

LABEL org.opencontainers.image.title="Bucephalus Cloud Pool Controller"
LABEL org.opencontainers.image.description="Bucephalus Cloud pool controller image built from a verified release bundle"
LABEL org.opencontainers.image.version="${BUCEPHALUS_RELEASE_VERSION}"
LABEL org.opencontainers.image.revision="${BUCEPHALUS_RELEASE_GIT_SHA}"
LABEL org.bucephalus.release.manifest.sha256="${BUCEPHALUS_RELEASE_MANIFEST_SHA256}"
LABEL org.bucephalus.image.component="${BUCEPHALUS_IMAGE_COMPONENT}"
LABEL org.bucephalus.image.contract="cloud-release-bundle-v1"

ENV BUCEPHALUS_RELEASE_VERSION="${BUCEPHALUS_RELEASE_VERSION}"
ENV BUCEPHALUS_RELEASE_GIT_SHA="${BUCEPHALUS_RELEASE_GIT_SHA}"

WORKDIR /opt/bucephalus-cloud

COPY --chown=bun:bun bucephalus-cloud/runtime-dist/poolController.js ./runtime-dist/poolController.js
COPY --chown=bun:bun bucephalus-cloud/deploy/provider/gcp ./deploy/provider/gcp

USER bun
ENTRYPOINT ["bun", "runtime-dist/poolController.js"]
