{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alerts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "business_action": { "type": "string" },
          "causal_event_id": { "type": "string" },
          "exposure_kind": {
            "enum": ["physical_supply", "demand_acceleration", "regulatory_compliance", "reputational", "procurement_arbitrage", "capacity_reallocation"],
            "type": "string"
          },
          "hypothesis_confidence": {
            "enum": ["low", "medium", "high"],
            "type": "string"
          },
          "key_assumption": { "type": "string" },
          "latent_edge": { "type": "string" }
        },
        "required": ["causal_event_id", "latent_edge", "exposure_kind", "hypothesis_confidence", "key_assumption", "business_action"],
        "type": "object"
      },
      "type": "array"
    },
    "no_alert_paths_considered": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "candidate_path_examined": { "type": "string" },
          "event_id": { "type": "string" },
          "reason_dismissed": { "type": "string" }
        },
        "required": ["event_id", "reason_dismissed"],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": ["alerts", "no_alert_paths_considered"],
  "title": "Peter Gregory Event-Only Exposure Scan",
  "type": "object"
}
