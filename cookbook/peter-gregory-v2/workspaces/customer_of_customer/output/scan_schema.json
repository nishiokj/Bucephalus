{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alerts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "affected_customers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "affected_orders": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "affected_products": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "business_action": {
            "description": "One-sentence recommended action (e.g. 'Pre-buy 90 days of castor polyol from secondary supplier').",
            "type": "string"
          },
          "causal_event_id": {
            "description": "Event id from the day's feed (e.g. H03, E03, R04, T05).",
            "type": "string"
          },
          "constrained_inventory": {
            "type": "boolean"
          },
          "exposure_kind": {
            "enum": [
              "physical_supply",
              "demand_acceleration",
              "regulatory_compliance",
              "reputational"
            ],
            "type": "string"
          },
          "latent_edge": {
            "description": "Hops from the external event to the affected order, written as 'A \u2192 B \u2192 C \u2192 order'.",
            "type": "string"
          },
          "revenue_at_risk": {
            "type": "number"
          },
          "supporting_records": {
            "description": "Workspace-relative paths consulted for this alert.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "causal_event_id",
          "latent_edge",
          "affected_orders",
          "revenue_at_risk",
          "exposure_kind",
          "business_action",
          "supporting_records"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "no_alert_paths_considered": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "candidate_path_examined": {
            "description": "Brief sketch of the path you walked before dismissing (optional).",
            "type": "string"
          },
          "event_id": {
            "type": "string"
          },
          "reason_dismissed": {
            "description": "Why this headline does not create exposure on any open order.",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "reason_dismissed"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "alerts",
    "no_alert_paths_considered"
  ],
  "title": "Peter Gregory Daily Exposure Scan",
  "type": "object"
}
