{
  "models": {
    "available": [],
    "default": ""
  },
  "agents": {
    "standard": {
      "llm": {
        "role": "standard",
        "max_tokens": 128000,
        "temperature": 0.7
      },
      "budget": {
        "max_iterations": 300,
        "max_tool_calls": 0,
        "max_duration_ms": 1000000
      },
      "tools": [
        "mcp:*"
      ],
      "output_schema": "goal_driven"
    },
    "context_compactor": {
      "llm": {
        "role": "fast",
        "max_tokens": 200000,
        "temperature": 0.3
      },
      "budget": {
        "max_iterations": 3,
        "max_tool_calls": 0,
        "max_duration_ms": 45000
      },
      "output_schema": "agent_action"
    }
  },
  "tools": {
    "bash_timeout_ms": 120000,
    "max_output_length": 10000,
    "execution_backend": "native",
    "executioner_workspace": "existing"
  },
  "graphd": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 9444,
    "db_path": "~/.graphd/graphd.db"
  },
  "context": {
    "max_tokens": 200000,
    "session_ttl_ms": 7200000
  },
  "skills": {
    "enabled": false,
    "directory": ".agent/skills"
  },
  "hooks": {
    "enabled": true,
    "directory": "config/hooks"
  },
  "auth": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 9556,
    "session_expiry_days": null
  },
  "memory": {
    "enabled": false,
    "base_url": "http://localhost:3001",
    "timeout_ms": 5000
  },
  "mcp": {
    "enabled": true,
    "servers": []
  }
}
