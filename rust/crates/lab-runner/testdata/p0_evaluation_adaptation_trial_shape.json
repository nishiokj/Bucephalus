{
  "resolved_experiment": {
    "version": "0.5",
    "design": {
      "max_concurrency": 8,
      "policies": {
        "scheduling": "paired_interleaved",
        "retry": {
          "max_attempts": 2,
          "retry_on": [
            "error",
            "timeout"
          ]
        },
        "concurrency": {
          "max_in_flight_per_variant": 2,
          "require_chain_lease": true
        }
      }
    },
    "evaluation": {
      "policy": {
        "task_model": "dependent",
        "scoring_lifecycle": "predict_then_score",
        "required_evidence_classes": [
          "agent_patch",
          "grader_report"
        ],
        "chain_failure_policy": "continue_with_flag"
      }
    }
  },
  "dataset_task_row": {
    "schema_version": "task_row_v2",
    "id": "project__case__12345",
    "time_limit_ms": 1800000,
    "task": {
      "id": "project__case__12345",
      "prompt": "Fix failing tests without changing expected behavior."
    },
    "runtime": {
      "container_image": {
        "image": "ghcr.io/acme/project-eval-task:20260222",
        "workdir": "/testbed"
      }
    }
  }
}
