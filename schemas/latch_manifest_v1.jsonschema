{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bucephalus.dev/latch_manifest_v1.jsonschema",
  "title": "Bucephalus Latch Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": { "const": "latch_manifest_v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "defaults": { "$ref": "#/$defs/defaults" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "launch": { "$ref": "#/$defs/launch" },
        "workspace_seed": { "$ref": "#/$defs/workspace_seed" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "idle_timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "task_prompt"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "task_prompt": { "type": "string", "minLength": 1 },
        "workspace_seed": { "$ref": "#/$defs/workspace_seed" },
        "expected_output": { "$ref": "#/$defs/expected_output" },
        "upload": { "$ref": "#/$defs/upload" },
        "materialization": {
          "type": "array",
          "items": { "$ref": "#/$defs/case_materialization_step" }
        },
        "metadata": true
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "task_injection": {
          "type": "string",
          "enum": ["argv", "stdin", "file"],
          "default": "argv"
        },
        "cwd": { "type": "string", "minLength": 1, "default": "workspace" },
        "env": { "$ref": "#/$defs/launch_env" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "idle_timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "launch_env": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inherit": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "set": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "workspace_seed": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "empty" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "anyOf": [{ "required": ["path"] }, { "required": ["ref"] }],
          "properties": {
            "kind": { "const": "files" },
            "path": { "type": "string", "minLength": 1 },
            "ref": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "anyOf": [{ "required": ["path"] }, { "required": ["ref"] }],
          "properties": {
            "kind": { "const": "archive" },
            "path": { "type": "string", "minLength": 1 },
            "ref": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repo"],
          "properties": {
            "kind": { "const": "git" },
            "repo": { "type": "string", "minLength": 1 },
            "rev": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "expected_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["workspace_diff", "file", "text"]
        }
      }
    },
    "upload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result_url": { "type": "string", "minLength": 1 },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "case_materialization_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "operation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "enum": ["case", "agent", "grader"] },
        "operation": { "type": "string", "enum": ["command", "copy", "mount", "extract_archive"] },
        "command": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "resource": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": true
        },
        "mount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "minLength": 1, "pattern": "^/" },
            "read_only": { "type": "boolean" }
          }
        },
        "workdir": { "type": "string", "minLength": 1, "pattern": "^/" },
        "network": { "type": "string", "enum": ["none", "full", "allowlist_enforced"] },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "hidden": { "type": "boolean" }
      }
    }
  }
}
