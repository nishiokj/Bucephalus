{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-lab.local/schemas/resolved_experiment.json",
  "title": "Resolved Experiment",
  "type": "object",
  "additionalProperties": true,
  "required": ["experiment", "runtime", "matrix", "trial_runtime", "policy"],
  "properties": {
    "experiment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "owner": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "compute": { "$ref": "#/$defs/backend" },
        "storage": { "$ref": "#/$defs/backend" },
        "traces": { "$ref": "#/$defs/backend" },
        "registry": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "default": { "type": "string", "minLength": 1 }
          }
        },
        "secrets": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtime_secret" }
        },
        "network": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "default": { "$ref": "#/$defs/network_mode" },
            "task_sandbox": { "$ref": "#/$defs/network_mode" },
            "agent": { "$ref": "#/$defs/network_mode" },
            "egress": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": true,
      "required": ["variants", "tasks", "repeats"],
      "properties": {
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        },
        "tasks": {
          "type": "object",
          "additionalProperties": true,
          "required": ["source", "path"],
          "properties": {
            "source": {
              "oneOf": [
                { "type": "string", "enum": ["file"] },
                {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["type"],
                  "properties": { "type": { "type": "string", "enum": ["file"] } }
                }
              ]
            },
            "path": { "type": "string", "minLength": 1 },
            "suite_id": { "type": "string", "minLength": 1 },
            "split_id": { "type": "string", "minLength": 1 },
            "limit": { "type": "integer", "minimum": 0 }
          }
        },
        "repeats": { "type": "integer", "minimum": 1 },
        "seeds": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "max_concurrency": { "type": "integer", "minimum": 1 },
        "shuffle_tasks": { "type": "boolean" },
        "random_seed": { "type": "integer" },
        "comparison": { "type": "string", "enum": ["paired", "unpaired", "none"] }
      }
    },
    "trial_runtime": { "type": "object", "additionalProperties": true },
    "sidecars": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sidecar" }
    },
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["timeout_ms", "task_sandbox"],
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "sanitization_profile": {
          "type": "string",
          "enum": ["replay_strict", "hermetic_functional", "perf_benchmark"]
        },
        "task_sandbox": { "type": "object", "additionalProperties": true },
        "validity": { "type": "object", "additionalProperties": true },
        "policies": { "type": "object", "additionalProperties": true }
      }
    },
    "extra_outputs": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "backend": {
      "type": "object",
      "additionalProperties": true,
      "required": ["backend"],
      "properties": {
        "backend": { "type": "string", "minLength": 1 },
        "config": { "type": "object", "additionalProperties": true }
      }
    },
    "network_mode": {
      "type": "string",
      "enum": ["none", "full", "allowlist_enforced", "llm_egress"]
    },
    "variant": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "baseline": { "type": "boolean" },
        "config": { "type": "object", "additionalProperties": true },
        "overrides": { "type": "object", "additionalProperties": true }
      }
    },
    "runtime_secret": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "from"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "enum": ["env", "file"] },
        "mount": {
          "type": "object",
          "additionalProperties": true,
          "required": ["target"],
          "properties": {
            "target": { "type": "string", "minLength": 1 },
            "required_for_variants": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "credential_cache": { "type": "object", "additionalProperties": true }
      }
    },
    "sidecar": {
      "type": "object",
      "additionalProperties": true,
      "required": ["image"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "lifecycle": { "type": "string", "enum": ["per-trial"] },
        "expose": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
