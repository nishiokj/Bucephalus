{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-lab.local/schemas/task_row_v2.json",
  "title": "Task Row v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "task"],
  "properties": {
    "schema_version": { "const": "task_row_v2" },
    "id": { "type": "string", "minLength": 1 },
    "time_limit_ms": { "type": "integer", "minimum": 1 },
    "task": {
      "type": "object",
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "container_image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "workdir"],
          "properties": {
            "image": { "type": "string", "minLength": 1 },
            "workdir": {
              "type": "string",
              "minLength": 1,
              "pattern": "^/"
            },
            "platform": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
