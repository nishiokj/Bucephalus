{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-lab.local/schemas/prepared_runtime_image_map_v1.json",
  "title": "Prepared Runtime Image Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "entries"],
  "properties": {
    "schema_version": { "const": "prepared_runtime_image_map_v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "base_image",
          "agent_artifact_digest",
          "agent_artifact_mount_path",
          "runner_contract_version",
          "prepared_image"
        ],
        "properties": {
          "base_image": { "type": "string", "minLength": 1 },
          "agent_artifact_digest": { "type": "string", "minLength": 1 },
          "agent_artifact_mount_path": { "type": "string", "minLength": 1 },
          "runner_contract_version": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "minLength": 1 },
          "prepared_image": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
